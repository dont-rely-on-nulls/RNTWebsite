{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "hugo",
      "runtimeExecutable": "nix",
      "runtimeArgs": ["shell", "nixpkgs#hugo", "-c", "hugo", "server", "--port", "1313", "--bind", "127.0.0.1"],
      "port": 1313
    },
    {
      "name": "rnt-web",
      "runtimeExecutable": "nix",
      "runtimeArgs": ["shell", "nixpkgs#python3", "-c", "python3", "-m", "http.server", "8000", "--bind", "127.0.0.1", "--directory", "../Web/result"],
      "port": 8000
    }
  ]
}
